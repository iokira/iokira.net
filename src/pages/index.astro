---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
    pageTitle="iokira.net"
    description="カフェインに弱い、コーヒー・紅茶・読書愛好家、吉良伊織 (iokira) の個人サイト。"
>
    <section class="hero">
        <h1 class="site-name">iokira.net</h1>
        <p class="tagline">カフェインに弱い、コーヒー・紅茶・読書愛好家。</p>
    </section>
</BaseLayout>

<style>
    .hero {
        padding-block: 3rem 2rem;
    }

    .site-name {
        font-size: clamp(1.75rem, 5vw, 2.5rem);
        font-weight: 700;
        margin: 0 0 0.5rem;
        letter-spacing: -0.02em;
    }

    .tagline {
        color: var(--color-text-muted);
        font-size: 1rem;
        margin: 0;
    }
</style>
