---
import BaseLayout from "@layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import profileImage from "../assets/profile.jpg";

const accounts = [
    {
        link: "https://github.com/iokira",
        name: "GitHub",
        icon: "M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.57.11.78-.25.78-.55 0-.27-.01-1.16-.02-2.11-3.2.7-3.88-1.36-3.88-1.36-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.24 2.76.12 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.07.78 2.15 0 1.55-.01 2.8-.01 3.18 0 .3.21.66.79.55A11.5 11.5 0 0 0 23.5 12c0-6.27-5.23-11.5-11.5-11.5Z",
    },
    {
        link: "https://x.com/iokira_jp",
        name: "X (Twitter)",
        icon: "M18.24 2h3.26l-7.5 8.57L22.9 22h-6.9l-5.4-7.06L4.4 22H1.14l8.03-9.18L1 2h7.06l4.88 6.45L18.24 2Zm-1.21 18h1.9L7.02 4h-1.9l11.9 16Z",
    },
];
const email = "iam.iokiller@gmail.com";
const mailIcon =
    "M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z";
const qualifications = [
    { name: "普通自動車第一種運転免許" },
    { name: "AWS Certified Cloud Practitioner" },
    { name: "AWS Certified AI Practitioner" },
    { name: "AWS Certified Solutions Architect - Associate" },
    { name: "AWS Certified SysOps Administrator - Associate" },
    { name: "AWS Certified Developer - Associate" },
    { name: "AWS Certified Machine Learning Engineer - Associate" },
    { name: "AWS Certified Data Engineer - Associate" },
    { name: "AWS Certified Solutions Architect - Professional" },
    { name: "AWS Certified DevOps Engineer - Professional" },
    { name: "AWS Certified Advanced Networking - Specialty" },
    { name: "3級ファイナンシャル・プランニング技能士" },
];
const bio = [
    { year: 2004, event: "福岡県に生まれる" },
    { year: 2024, event: "久留米工業高等専門学校制御情報工学科を卒業" },
    { year: 2024, event: "チームラボ株式会社に入社" },
];

// 検索エンジン・生成 AI に人物として同定させるための構造化データ。
// sameAs が各 SNS プロフィールを同一人物として束ねる。
const structuredData = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "吉良伊織",
    alternateName: ["iokira", "Kira Iori"],
    jobTitle: "エンジニア",
    description: "カフェインに弱いコーヒー・紅茶・読書愛好家。",
    url: Astro.site?.href,
    image: new URL(profileImage.src, Astro.site).href,
    email: `mailto:${email}`,
    sameAs: accounts.map((account) => account.link),
    alumniOf: {
        "@type": "CollegeOrUniversity",
        name: "久留米工業高等専門学校",
    },
    worksFor: {
        "@type": "Organization",
        name: "チームラボ株式会社",
    },
    knowsAbout: [
        "Amazon Web Services",
        "クラウドアーキテクチャ",
        "DevOps",
        "機械学習",
        "データエンジニアリング",
    ],
    hasCredential: qualifications.map((qualification) => ({
        "@type": "EducationalOccupationalCredential",
        name: qualification.name,
    })),
};
---

<BaseLayout
    pageTitle="iokira.net"
    description="吉良伊織 (iokira) の個人サイト。カフェインに弱い、コーヒー・紅茶・読書愛好家のエンジニア。"
    ogType="profile"
    structuredData={structuredData}
>
    <div class="headline">
        <div class="texts">
            <div class="identity">
                <h1 class="name">iokira</h1>
                <p class="real-name">吉良伊織 (Kira Iori)</p>
                <div class="sns-links">
                    {
                        accounts.map((account) => (
                            <a
                                href={account.link}
                                class="sns-link"
                                target="_blank"
                                rel="me noopener noreferrer"
                                aria-label={account.name}
                            >
                                <svg
                                    viewBox="0 0 24 24"
                                    width="20"
                                    height="20"
                                    aria-hidden="true"
                                >
                                    <path
                                        d={account.icon}
                                        fill="currentColor"
                                    />
                                </svg>
                            </a>
                        ))
                    }
                    <a
                        href={`mailto:${email}`}
                        class="sns-link"
                        aria-label={`メール: ${email}`}
                    >
                        <svg
                            viewBox="0 0 24 24"
                            width="20"
                            height="20"
                            aria-hidden="true"
                        >
                            <path
                                d={mailIcon}
                                fill="currentColor"
                            ></path>
                        </svg>
                    </a>
                </div>
            </div>
            <p class="comment">カフェインに弱いコーヒー・紅茶・読書愛好家。</p>
        </div>
        <Image
            class="profile-image"
            src={profileImage}
            alt="プロフィール画像: 焙煎されたコーヒー豆"
            width={240}
            height={240}
            loading="eager"
            fetchpriority="high"
        />
    </div>
    <h2>Bio</h2>
    <hr />
    <div class="bio">
        {
            bio.map((item) => (
                <div class="bio-item">
                    <b>{item.year}</b>
                    <span>{item.event}</span>
                </div>
            ))
        }
    </div>
    <br />
    <h2>趣味</h2>
    <hr />
    <h3>コーヒー</h3>
    <p>
        最近はエチオピアの深煎りが気に入ってます。他にもスマトラとかゲイシャ種も好き。普段は家でペーパードリップだけど、あまり上手には淹れられないです。
        仕事の合間にはグァテマラの深煎りをアイスで飲むことが多いです。苦いアイスコーヒーっていいですよね。
        でも実はこっそりニカラグアの浅煎りとかも飲んでます。酸味も苦みも、美味しいですよね。
    </p>
    <h3>本</h3>
    <p>特にミステリと SF が好きです。</p>
    <p>
        特にお気に入りなのは京極夏彦の「姑獲鳥の夏」、夢野久作の「ドグラ・マグラ」、アガサ・クリスティの「ナイルに死す」です。
        あと最近劉慈欣の「三体」シリーズを読了しまして、絶賛三体ロスです。
    </p>
    <p>
        他にも青空文庫で公開されている短編を読むのが好きで、宮沢賢治の「ポラーノの広場」や江戸川乱歩の「人間椅子」、夢野久作の「瓶詰め地獄」、坂口安吾の「堕落論」が気に入ってます。
    </p>
    <p>いつか読んだ本紹介ページとか作りたいですね。</p>
    <h3>曲</h3>
    <p>ジャンル問わず、気に入った曲をヘビロテしています。</p>
    <p>最近は Slipknot、 Earth, Wind & Fire、小沢健二をよく聴いています。</p>
    <p>
        邦ロックだと THE BACK HORN、 People In The Box、 ASIAN KUNG-FU
        GENERATION が好き。
    </p>
    <p>
        メタルは Metallica、 Slipknot、 Crossfaith、
        Periphery、明日の叙景、Earthists をよく聞きます。特に Slipknot、Wherein
        Lies Continue や Before I Forget、 The Virus of Life、 Skeptic、
        Vermilion、 The Devil in I、
        Lech、などなど好きな曲を挙げだすときりがないですね。
    </p>
    <br />
    <h2>その他</h2>
    <hr />
    <h3>資格</h3>
    <ul>
        {qualifications.map((qualification) => <li>{qualification.name}</li>)}
    </ul>
</BaseLayout>

<style lang="scss">
    .headline {
        padding-block: 2.5rem 2rem;
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: flex-start;
        gap: 2rem;
        border-bottom: 1px solid var(--color-border);
        margin-bottom: 2rem;
    }

    .identity {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem 1rem;
        margin-bottom: 0.75rem;
    }

    .name {
        font-size: clamp(1.75rem, 5vw, 2.5rem);
        margin: 0;
        letter-spacing: -0.02em;
    }

    .real-name {
        color: var(--color-text-muted);
        margin: 0;
        font-size: 0.95rem;
    }

    .comment {
        margin: 0;
        font-size: 0.95rem;
    }

    .sns-links {
        display: flex;
        flex-direction: row;
        gap: 0.75rem;
    }

    .sns-link {
        display: inline-flex;
        color: var(--color-text-muted);
        text-decoration: none;
    }

    .sns-link:hover {
        color: var(--color-accent);
    }

    .profile-image {
        border-radius: 50%;
        object-fit: cover;
        flex-shrink: 0;
        width: 120px;
        height: 120px;

        @media screen and (max-width: 600px) {
            width: 80px;
            height: 80px;
        }
    }

    .bio {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;

        > .bio-item {
            display: flex;
            flex-direction: row;
            gap: 1.5rem;

            > b {
                flex-shrink: 0;
                white-space: nowrap;
            }

            > span {
                min-width: 0;
            }
        }
    }
</style>
